# Copy to server/.env for local development (and to .env in the repo root on the
# production server, where docker-compose.yml reads it). Never commit real values.

# Discord application (Developer Portal > your app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# PostgreSQL connection string (local Docker Postgres in development).
# In production docker-compose.yml builds this from POSTGRES_PASSWORD instead.
DATABASE_URL=

# Production only: password for the Postgres container in docker-compose.yml
POSTGRES_PASSWORD=

# Signs the login cookie. Use a long random string.
JWT_SECRET=
# Encrypts stored Discord OAuth tokens. Generate with: openssl rand -base64 32
# Falls back to a key derived from JWT_SECRET if unset
TOKEN_ENCRYPTION_KEY=

# Where to send people after logging in (the Vite dev server locally)
CLIENT_URL=http://localhost:5173

# Optional: API port (default 3000). NODE_ENV is set to production by docker-compose.yml.
PORT=
